{
  "info": {
    "name": "RealtyIQ API",
    "description": "Postman collection for testing the RealtyIQ backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\",\n  \"phone\": \"+14155550100\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Lead\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"+14155550100\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"budget_min\": 100000,\n  \"budget_max\": 300000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads"]
            }
          },
          "response": []
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send WhatsApp Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_id\": \"{{leadId}}\",\n  \"body\": \"Hello from Postman\",\n  \"channel\": \"whatsapp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "Send Email Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_id\": \"{{leadId}}\",\n  \"body\": \"Hello from Postman email test\",\n  \"channel\": \"email\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Follow Ups",
      "item": [
        {
          "name": "Trigger Follow Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/follow-ups/trigger/{{leadId}}/3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "follow-ups", "trigger", "{{leadId}}", "3"]
            }
          },
          "response": []
        },
        {
          "name": "Get Pending Follow Ups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/follow-ups/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "follow-ups", "pending"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
